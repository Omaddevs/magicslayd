# Nusxa oling: copy .env.example .env

# API porti
PORT=3001

# Bot papkasi (shu papkaga nisbatan yoki to'liq yo'l). BOT_TOKEN, ADMIN_ID va DATA_DIR (baza) shu yerdan olinadi
BOT_DIR=../../bot

# Baza boshqa joyda bo'lsa (standart: botning DATA_DIR i → magicslayd/data/bot.db)
# DB_PATH=

# Faqat lokal sinov uchun: Telegram'siz brauzerda ochilganda shu ID egasi sifatida kiriladi.
# Serverda (NODE_ENV=production) e'tiborga olinmaydi
DEV_USER_ID=
