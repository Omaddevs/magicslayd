# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring

# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Sizning Telegram ID'ingiz (@userinfobot dan bilib olasiz) — bot egasi (bosh admin)
ADMIN_ID=
# Qo'shimcha adminlar soni (siz botda /adminlar yoki web admin panelda qo'shasiz). Standart: 2
# ADMINS_EXTRA_MAX=2

# Claude API kaliti (platform.claude.com → API Keys)
ANTHROPIC_API_KEY=

# To'lov kartalari: «raqam | egasi», bir nechta bo'lsa «;» bilan ajrating
PAYMENT_CARDS=8600 0000 0000 0000 | Ism Familiya

# Slaydlar uchun rasmlar (bepul): https://pixabay.com/api/docs/ — yozilmasa Wikimedia ishlatiladi
PIXABAY_API_KEY=

# Shablonlar rasmlarini BEPUL chizish — Cloudflare Workers AI (FLUX), kuniga ~130 rasm, karta shart emas.
# dash.cloudflare.com → Account ID (o'ng tomonda) va My Profile → API Tokens → «Workers AI» shabloni bilan token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Shablonlar (Korporativ, Daftar, Tarix, Barokko) rasmlarini AI chizadi — Google Gemini kaliti (pullik, sifatliroq)
# (aistudio.google.com → Get API key). Yozilmasa — shablon rasmlari ham fotobazadan olinadi
GEMINI_API_KEY=
# Model: gemini-nano-banana-2.1 (standart) | gemini-3.1-flash-lite-image (arzon, tez) | gemini-3-pro-image (eng sifatli)
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Savollar uchun admin username (ixtiyoriy, @ siz)
SUPPORT_USERNAME=

# Web ilova (slayd-web) manzili, https bilan. Yozilsa — chatdagi menyu tugmasi ilovani ochadi
WEBAPP_URL=

# Ma'lumotlar (baza, loyihalar) papkasi — bot papkasiga nisbatan. Docker'da avtomatik /data
DATA_DIR=../data

# AI yordamchi (sayt va bot): kunlik bepul limit va model. Kalit — yuqoridagi ANTHROPIC_API_KEY
AI_ASSISTANT_DAILY_LIMIT=3
# AI_ASSISTANT_PER_MINUTE=2
# AI_ASSISTANT_MODEL=claude-sonnet-5-5

# --- Ixtiyoriy sozlamalar ---
# Matn yozuvchi model: claude-haiku-5-5 (eng arzon, standart) | claude-sonnet-5-5 | claude-opus-5-5 (eng qimmat)
# AI_MODEL_WRITER=claude-haiku-5-5
# Claude'ga bir vaqtda ketadigan so'rovlar soni (Anthropic tarifi oshsa ko'paytiring)
# API_CONCURRENCY=20
